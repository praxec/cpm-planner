  "author": "Matthew Cochran <matthew@cochranweb.com>",
  "homepage": "https://github.com/praxec/cpm-planner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praxec/cpm-planner.git",
    "directory": "npm"
  },
  "bugs": {
    "url": "https://github.com/praxec/cpm-planner/issues"
  },
  "bin": {
    "cpm-planner": "bin/cpm-planner.js",
    "cpm": "bin/cpm-planner.js"
  },
  "files": [
    "bin/cpm-planner.js",
    "lib/install.js",
    "lib/postinstall.js",
    "README.md",
    "LICENSE",
